{
  "info": {
    "name": "EmpSphere - Week 1 (Auth & Departments)",
    "_postman_id": "empsphere-week1-auth-departments",
    "description": "Collection covering the Week 1 deliverables: Authentication (register, login, logout, me, refresh token, change password, forgot/reset password) and Department CRUD. Base URL is http://127.0.0.1:8000/api. Use the Login request to capture an access token, then the department requests will use it automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "departmentId",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"phone\": \"+1234567890\",\n  \"password\": \"StrongPass@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register/",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register", ""]
            },
            "description": "Create a new employee account. Returns the new user_id. Expect 201."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data) {",
                  "  pm.collectionVariables.set('accessToken', json.data.access_token);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refresh_token);",
                  "}",
                  "pm.test('Login returns 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@empsphere.com\",\n  \"password\": \"Admin@12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login/",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login", ""]
            },
            "description": "Log in with credentials. Response includes access_token and refresh_token. Expect 200."
          },
          "response": []
        },
        {
          "name": "Get Me (Profile)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me/",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me", ""]
            },
            "description": "Fetch the current authenticated user's profile. Requires a valid access token. Expect 200."
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh-token/",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh-token", ""]
            },
            "description": "Exchange a valid refresh token for a fresh access token. Expect 200."
          },
          "response": []
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"old_password\": \"CurrentPass@123\",\n  \"new_password\": \"NewPass@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/change-password/",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "change-password", ""]
            },
            "description": "Change the authenticated user's password. Expect 200."
          },
          "response": []
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password/",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "forgot-password", ""]
            },
            "description": "Request a password reset. Expect 200."
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<reset-token>\",\n  \"new_password\": \"NewPass@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password/",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "reset-password", ""]
            },
            "description": "Reset the password using the token from the reset email. Expect 200."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout/",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout", ""]
            },
            "description": "Blacklist the refresh token and log out. Expect 200."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Departments",
      "item": [
        {
          "name": "Create Department",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.department_id) {",
                  "  pm.collectionVariables.set('departmentId', json.data.department_id);",
                  "}",
                  "pm.test('Create returns 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Engineering\",\n  \"code\": \"ENG\",\n  \"description\": \"Software engineering department\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/organization/departments/",
              "host": ["{{baseUrl}}"],
              "path": ["organization", "departments", ""]
            },
            "description": "Create a new department (Admin/Super Admin only). Expect 201."
          },
          "response": []
        },
        {
          "name": "List Departments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/organization/departments/",
              "host": ["{{baseUrl}}"],
              "path": ["organization", "departments", ""]
            },
            "description": "Fetch all departments (HR Manager/Admin/Super Admin). Expect 200."
          },
          "response": []
        },
        {
          "name": "Get Department",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/organization/departments/{{departmentId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["organization", "departments", "{{departmentId}}", ""]
            },
            "description": "Fetch a single department by id. Expect 200."
          },
          "response": []
        },
        {
          "name": "Update Department",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Engineering\",\n  \"code\": \"ENG\",\n  \"description\": \"Updated engineering department\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/organization/departments/{{departmentId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["organization", "departments", "{{departmentId}}", ""]
            },
            "description": "Update an existing department (Admin/Super Admin only). Expect 200."
          },
          "response": []
        },
        {
          "name": "Delete Department",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/organization/departments/{{departmentId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["organization", "departments", "{{departmentId}}", ""]
            },
            "description": "Soft-delete a department (Super Admin only). Expect 200."
          },
          "response": []
        }
      ]
    }
  ]
}
