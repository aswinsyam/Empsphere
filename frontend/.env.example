# EmpSphere Frontend Environment Variables
# Copy this file to .env for local development.
# In production (e.g. Vercel), set these in the project's environment settings.
# Do NOT commit real .env files.

# Backend API base URL.
#   Local dev:  http://127.0.0.1:8000/api
#   Production: https://<your-deployed-django-backend>/api
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Frontend app URL (used for email links).
VITE_APP_URL=http://localhost:3000

# Google OAuth client id (optional).
VITE_GOOGLE_CLIENT_ID=

# Cashfree uses publishable app id only on the frontend if needed.
# Never put CASHFREE_SECRET_KEY here — it belongs in the backend.
