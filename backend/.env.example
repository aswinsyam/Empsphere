# EmpSphere Backend Environment Variables
# Copy this file to .env and fill in real values locally.
# NEVER commit a real .env file. Only this example is safe to commit.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB
MONGO_URI=mongodb://localhost:27017/empsphere_db
DATABASE_NAME=empsphere_db

# JWT
JWT_SECRET=change-me-to-a-long-random-string

# Password reset
PASSWORD_RESET_TOKEN_EXP_MINUTES=10

# Email (SMTP) — leave EMAIL_BACKEND as console for local dev if needed
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cashfree (Sandbox only — do NOT switch back to Razorpay)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=SANDBOX
CASHFREE_API_VERSION=2025-01-01

# Bootstrap super admin
SUPER_ADMIN_EMAIL=admin@empsphere.com
SUPER_ADMIN_PASSWORD=Admin@12345
SUPER_ADMIN_EMPLOYEE_CODE=EMP001
COMPANY_REGISTRATION_SECRET=3456